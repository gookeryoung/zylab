    {
      "id": "344d75d742b448b6b60188115ff90303",
      "source": "# 二维稳态热传导 — 数值方法（有限差分）\n# 二维泊松方程: d²T/dx² + d²T/dy² = 0，用中心差分离散为代数方程组\n# 迭代法（雅可比）求解：T_new[i,j] = (T[i-1,j]+T[i+1,j]+T[i,j-1]+T[i,j+1])/4\n# 矩形域 1m×1m，底边 100°C，其余边界 0°C\nN = 50  # 网格数\nL = 1.0  # 域边长\ndx = dy = L / (N - 1)\nT = zeros((N, N))\nT[0, :] = 100.0  # 底边\nT[1:, 0] = 0.0; T[1:, -1] = 0.0; T[-1, :] = 0.0\nfor _ in range(5000):  # 雅可比迭代\n    T_old = T.copy()\n    T[1:-1, 1:-1] = (T_old[:-2, 1:-1] + T_old[2:, 1:-1] + T_old[1:-1, :-2] + T_old[1:-1, 2:]) / 4\n    T[0, :] = 100.0; T[-1, :] = 0.0; T[:, 0] = 0.0; T[:, -1] = 0.0\n# 中线温度剖面\nmid = N // 2\nplot(linspace(0, L, N), T[:, mid], title=\"方形域二维稳态热传导 — 中线温度剖面\", xlabel=\"y (m)\", ylabel=\"T (°C)\", label=f\"x={L/2:.1f}m 截面\")\nprint(f\"收敛后中心温度 T({L/2},{L/2}) = {T[mid,mid]:.2f}°C\")\n",
      "execution_count": 4,
      "outputs": [
        {
          "kind": "stream",
          "name": "stdout",
          "text": "收敛后中心温度 T(0.5,0.5) = 24.15°C\n"
        },
