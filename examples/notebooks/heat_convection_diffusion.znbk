    {
      "id": "d73d9c91eb384e4aa592e0175018df23",
      "source": "# 对流换热 — 牛顿冷却定律与 Nu-Re-Pr 关系\n# Q = h·A·ΔT，h 为对流换热系数，受流动状态影响\n# 层流 Nu = 3.66 (恒壁温)，湍流 Nu ≈ 0.023·Re^0.8·Pr^0.4\n# 以空气横掠圆柱为例：d=0.02m, v=10m/s, 空气 k=0.026 W/(m·K)\nd, v = 0.02, 10.0\nk_air = 0.026\nnu_air, rho_air = 1.5e-5, 1.225  # 运动粘度与密度\nPr = 0.71  # 普朗特数（空气）\nRe = v * d / nu_air\n# 假设层/湍临界 Re=2300，此处 Re=13333 → 湍流\nif Re < 2300:\n    Nu = 3.66\n    regime = \"层流\"\nelse:\n    Nu = 0.023 * Re ** 0.8 * Pr ** 0.4\n    regime = \"湍流\"\nh = Nu * k_air / d\nprint(f\"Re={Re:.0f}, 流动状态: {regime}, Nu={Nu:.2f}, h={h:.1f} W/(m²·K)\")\n# 不同流速下的 h 曲线\nv_range = linspace(1, 30, 100)\nRe_range = v_range * d / nu_air\nh_range = np.where(Re_range < 2300, 3.66, 0.023 * Re_range ** 0.8 * Pr ** 0.4) * k_air / d\nplot(v_range, h_range, title=f\"空气横掠圆柱换热系数 ({regime}为主)\", xlabel=\"流速 v (m/s)\", ylabel=\"h (W/m²·K)\", label=\"h(v)\")\nplot(array([10, 10]), array([0, h * 1.2]), label=f\"v={v} m/s\")\n",
      "execution_count": 3,
