    {
      "id": "bae10a6d4c0c4dcb914beee6d18ed8dc",
      "source": "# 中心极限定理（CLT）\n# 设 X_i ~ U(0,1)，则 μ=1/2、σ²=1/12。\n# 样本均值 X̄ 标准化后 Z = (X̄-μ)/(σ/√n) 依分布收敛到标准正态 N(0,1)\nfrom scipy.stats import norm\n\nrng = np.random.default_rng(42)\nsamples = 2000\nmu, sigma = 0.5, sqrt(1 / 12)\n\nz_axis = linspace(-4, 4, 400)\nplot(z_axis, norm.cdf(z_axis), title=\"中心极限定理：均匀样本均值 → 标准正态\", xlabel=\"Z = (X̄-μ)/(σ/√n)\", ylabel=\"累积概率\", label=\"标准正态 Φ(z)\")\n\nfor n in (2, 30):\n    means = rng.uniform(0, 1, size=(samples, n)).mean(axis=1)\n    z = (means - mu) / (sigma / sqrt(n))\n    z_sorted = np.sort(z)\n    ecdf = np.arange(1, samples + 1) / samples\n    plot(z_sorted, ecdf, label=f\"n={n}\")\n",
      "execution_count": 3,
