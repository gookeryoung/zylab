    {
      "id": "750f0b385e9b44b385b83f3254f07a82",
      "source": "# 线性回归（最小二乘）\n# 拟合 y = β₀ + β₁x，最小化残差平方和 Σ(yᵢ - (β₀+β₁xᵢ))²\n# 正规方程解：β₁ = Cov(x,y)/Var(x)，β₀ = ȳ - β₁x̄\nrng = np.random.default_rng(7)\nx = linspace(0, 10, 30)\ny_true = 2.5 * x + 1.0\ny = y_true + rng.normal(0, 1.5, size=x.shape)\n\nbeta1 = np.cov(x, y)[0, 1] / np.var(x)\nbeta0 = y.mean() - beta1 * x.mean()\nprint(f\"最小二乘拟合: y = {beta0:.3f} + {beta1:.3f}·x\")\n\nplot(x, y_true, title=\"线性回归（最小二乘）\", xlabel=\"x\", ylabel=\"y\", label=\"真实直线 y=2.5x+1\")\nplot(x, y, label=\"观测样本（含噪声）\")\nx_fit = array([x.min(), x.max()])\nplot(x_fit, beta0 + beta1 * x_fit, label=f\"拟合直线 y={beta0:.2f}+{beta1:.2f}x\")\n",
      "execution_count": 4,
