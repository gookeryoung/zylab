    {
      "id": "24274ea1b09c44c8a51f4085b10d1d5e",
      "source": "# 功率谱密度（PSD）— 频域能量分布\n# |X[k]|²/N 为第 k 个频率分量的功率，f_k = k·f_s/N\n# 峰值位置对应信号中的主频（50Hz 和 120Hz）\nX = np.fft.fft(x)\nfreqs = np.fft.fftfreq(N, d=t[1]-t[0])\npsd = abs(X) ** 2 / N\n# 只画正频率（单边谱）\npos = freqs > 0\nplot(freqs[pos], psd[pos], title=\"功率谱密度（PSD）\", xlabel=\"频率 f (Hz)\", ylabel=\"功率\", label=\"PSD\")\n# 标记 50Hz 和 120Hz\nfor f0 in (50, 120):\n    plot(array([f0, f0]), array([0, psd[pos].max() * 0.9]), label=f\"{f0}Hz\")\n",
      "execution_count": 2,
