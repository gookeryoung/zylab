    {
      "id": "6d95b2d6ccac4542a39bc49865721bc1",
      "source": "# 欧拉屈曲：细长压杆的临界载荷\n# P_cr = π²EI/(μL)²，μ 为长度系数：两端铰支 μ=1, 一端固定 μ=2, 两端固定 μ=0.5\n# 以无量纲 P/P_cr 为参数，展示后屈曲平衡路径\nmu_vals = {\"两端铰支 μ=1\": 1.0, \"一端固定 μ=2\": 2.0, \"两端固定 μ=0.5\": 0.5}\nx = linspace(0, 1, 400)\nfor label, mu in mu_vals.items():\n    P_cr = pi ** 2 / (mu ** 2)  # 取 EI=L=1\n    # 一阶屈曲模态: w(x) = A·sin(πx/L)\n    A = 0.1  # 假设幅值\n    w = A * sin(pi * x)\n    plot(x, w, title=\"欧拉屈曲一阶模态形状\", xlabel=\"位置 x/L\", ylabel=\"挠度 w\", label=f\"{label}, P_cr={P_cr:.3f}\")\nprint(\"各边界条件临界载荷（无量纲 π²EI/L² 单位）:\")\nfor label, mu in mu_vals.items():\n    print(f\"  {label}: P_cr = {pi**2/(mu**2):.2f}\")\n",
      "execution_count": 3,
      "outputs": [
