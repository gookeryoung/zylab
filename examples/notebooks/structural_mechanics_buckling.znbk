    {
      "id": "02c2ab9ec6cf463bac3ad0dee51f3b5b",
      "source": "# 材料力学第三强度理论（Tresca）— 应力圆与主应力\n# 平面应力状态 σ_x, σ_y, τ_xy → 主应力 σ₁, σ₂ 与最大剪应力\n# σ₁,₂ = (σ_x+σ_y)/2 ± √((σ_x-σ_y)²/4 + τ_xy²)\n# 莫尔圆: 圆心 ((σ_x+σ_y)/2, 0)，半径 √((σ_x-σ_y)²/4 + τ_xy²)\nsigma_x, sigma_y, tau = 80.0, 20.0, 30.0\nsigma_1 = (sigma_x + sigma_y) / 2 + sqrt((sigma_x - sigma_y) ** 2 / 4 + tau ** 2)\nsigma_2 = (sigma_x + sigma_y) / 2 - sqrt((sigma_x - sigma_y) ** 2 / 4 + tau ** 2)\nprint(f\"主应力 σ₁={sigma_1:.1f}, σ₂={sigma_2:.1f}, 最大剪应力 τ_max={(sigma_1-sigma_2)/2:.1f}\")\n# 莫尔圆\ntheta = linspace(0, 2 * pi, 200)\ncenter = (sigma_x + sigma_y) / 2\nradius = sqrt((sigma_x - sigma_y) ** 2 / 4 + tau ** 2)\nplot(center + radius * cos(theta), radius * sin(theta), title=\"莫尔应力圆\", xlabel=\"正应力 σ\", ylabel=\"剪应力 τ\", label=\"莫尔圆\")\nplot(array([sigma_x, sigma_y]), array([tau, -tau]), label=\"应力状态点\")\n",
