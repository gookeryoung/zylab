    {
      "id": "846b7526d67b4680848230b4ba97c0b0",
      "source": "# 数值求根：牛顿-拉夫森法\n# 求 f(x)=x³-2x-5=0 的根，迭代 x_{n+1} = x_n - f(x_n)/f'(x_n)\ndef f(x):\n    return x ** 3 - 2 * x - 5\n\ndef df(x):\n    return 3 * x ** 2 - 2\n\nx = 2.0\nhistory = [x]\nfor _ in range(20):\n    x = x - f(x) / df(x)\n    history.append(x)\n    if abs(f(x)) < 1e-12:\n        break\nprint(f\"牛顿法近似根: {x:.12f}\")\n\nerrors = array([abs(f(v)) for v in history])\nplot(arange(len(errors)), errors, title=\"牛顿法收敛（|f(x)| 随迭代次数）\", xlabel=\"迭代次数\", ylabel=\"|f(x)|\", label=\"|f(x)|\")\n",
      "execution_count": 3,
      "outputs": [
