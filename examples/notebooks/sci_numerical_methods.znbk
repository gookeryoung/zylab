    {
      "id": "bf5ff722e86940d7964a857a227ee27f",
      "source": "# 常微分方程数值解：逻辑斯蒂增长\n# dy/dt = r·y·(1 - y/K)，精确解 y(t) = K / (1 + ((K-y0)/y0)·e^(-rt))\n# 对比显式欧拉法与 4 阶龙格-库塔（RK4）\nr, K, y0 = 0.8, 100.0, 5.0\nt = linspace(0, 10, 100)\ndt = t[1] - t[0]\n\ndef rhs(y):\n    return r * y * (1 - y / K)\n\n# 欧拉法\ny_euler = np.zeros_like(t)\ny_euler[0] = y0\nfor i in range(len(t) - 1):\n    y_euler[i + 1] = y_euler[i] + dt * rhs(y_euler[i])\n\n# RK4\ny_rk4 = np.zeros_like(t)\ny_rk4[0] = y0\nfor i in range(len(t) - 1):\n    y = y_rk4[i]\n    k1 = rhs(y)\n    k2 = rhs(y + dt / 2 * k1)\n    k3 = rhs(y + dt / 2 * k2)\n    k4 = rhs(y + dt * k3)\n    y_rk4[i + 1] = y + dt / 6 * (k1 + 2 * k2 + 2 * k3 + k4)\n\ny_exact = K / (1 + (K - y0) / y0 * exp(-r * t))\nplot(t, y_exact, title=\"逻辑斯蒂增长 dy/dt = r·y(1-y/K)\", xlabel=\"t\", ylabel=\"y(t)\", label=\"精确解\")\nplot(t, y_euler, label=\"欧拉法\")\nplot(t, y_rk4, label=\"RK4\")\n",
      "execution_count": 2,
      "outputs": [
        {
          "kind": "plot",
          "title": "逻辑斯蒂增长 dy/dt = r·y(1-y/K)",
          "xlabel": "t",
          "ylabel": "y(t)",
          "series": [
            {
              "x": [
                0.0,
