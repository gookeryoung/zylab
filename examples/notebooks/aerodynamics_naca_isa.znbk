    {
      "id": "df9a9af97d38472db3dd9d3542d1c7e0",
      "source": "# 薄翼理论：升力系数随攻角线性变化\n# Cl = 2π·(α - α0)，α 为攻角（弧度），α0 为零升攻角\n# 对称翼型 α0=0°；带弯度翼型（如 NACA 2412）α0≈-2°\nalpha_deg = linspace(-5, 15, 200)\nalpha = np.deg2rad(alpha_deg)\ncl_sym = 2 * pi * alpha\ncl_cambered = 2 * pi * (alpha - np.deg2rad(-2))\nplot(alpha_deg, cl_sym, title=\"升力系数随攻角（薄翼理论）\", xlabel=\"攻角 α (°)\", ylabel=\"升力系数 Cl\", label=\"对称翼型 (α0=0°)\")\nplot(alpha_deg, cl_cambered, label=\"NACA 2412 (α0≈-2°)\")\n",
