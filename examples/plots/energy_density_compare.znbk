      "id": "2516cb10c6874500a4c9e52d5830a101",
      "source": "# 不同能量形式的能量密度对比（对数坐标分组柱状图）\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport pandas as pd\nfrom matplotlib import font_manager\nfrom matplotlib.patches import Patch\n\n\n# 跨平台中文字体自动选择（前置到默认 sans-serif 列表，保留 fallback 链）\n_CN_FONT_CANDIDATES = [\n    'DengXian', 'Microsoft YaHei', 'Microsoft YaHei UI',\n    'SimHei', 'KaiTi', 'STKaiti', 'FangSong', 'STFangsong',\n    'PingFang SC', 'Heiti SC', 'Hiragino Sans GB',\n    'WenQuanYi Micro Hei', 'WenQuanYi Zen Hei',\n    'Noto Sans CJK SC', 'Noto Sans SC', 'Source Han Sans SC',\n]\n_available_fonts = {f.name for f in font_manager.fontManager.ttflist}\n_selected_cn = [f for f in _CN_FONT_CANDIDATES if f in _available_fonts]\nif _selected_cn:\n    plt.rcParams['font.sans-serif'] = _selected_cn + plt.rcParams['font.sans-serif']\nplt.rcParams['axes.unicode_minus'] = False",
      "execution_count": 3,
